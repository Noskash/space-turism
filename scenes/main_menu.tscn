[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://ui/space_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/space_background.gdshader" id="3_bg"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bg"]
shader = ExtResource("3_bg")
shader_parameter/planet_center = Vector2(0.8, 0.78)
shader_parameter/planet_radius = 0.32
shader_parameter/warp = 0.0

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_bg")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 110
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="VBox" type="VBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Title" type="Label" parent="Content/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "SPACE TOURISM"

[node name="Subtitle" type="Label" parent="Content/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "A CO-OP MISSION TO MARS"

[node name="Spacer" type="Control" parent="Content/VBox"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
mouse_filter = 2

[node name="Buttons" type="VBoxContainer" parent="Content/VBox"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
size_flags_horizontal = 0
mouse_filter = 2
theme_override_constants/separation = 18

[node name="CreateRoomButton" type="Button" parent="Content/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_top = NodePath("../CharactersButton")
text = "CREATE ROOM"
alignment = 0

[node name="JoinButton" type="Button" parent="Content/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "JOIN ROOM"
alignment = 0

[node name="CharactersButton" type="Button" parent="Content/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_bottom = NodePath("../CreateRoomButton")
text = "MEET THE CREW"
alignment = 0

[node name="Fade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)
