[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_lobby"]
[ext_resource type="Theme" path="res://ui/space_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/space_background.gdshader" id="3_bg"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bg"]
shader = ExtResource("3_bg")
shader_parameter/nebula_color_a = Color(0.2, 0.15, 0.6, 1)
shader_parameter/nebula_color_b = Color(0.05, 0.45, 0.6, 1)
shader_parameter/nebula_strength = 0.8
shader_parameter/show_planet = false
shader_parameter/warp = 0.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_info"]
content_margin_left = 30.0
content_margin_top = 24.0
content_margin_right = 30.0
content_margin_bottom = 24.0
bg_color = Color(0.025, 0.045, 0.11, 0.8)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.75, 1, 0.4)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
shadow_color = Color(0.3, 0.8, 1, 0.12)
shadow_size = 30

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_notice"]
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0
bg_color = Color(0.03, 0.05, 0.12, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.75, 0.35, 0.7)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_bg")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
text = "КОМНАТА"

[node name="LeaveButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
