text = "ВЫЙТИ"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "ТЫ В КОМНАТЕ"

[node name="Body" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 40
alignment = 1

[node name="CardSlot" type="CenterContainer" parent="Margin/VBox/Body"]
