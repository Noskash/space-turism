[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level_select.gd" id="1_select"]
[ext_resource type="Theme" path="res://ui/space_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/space_background.gdshader" id="3_bg"]
[ext_resource type="Script" path="res://scripts/level_data.gd" id="4_data"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bg"]
shader = ExtResource("3_bg")
shader_parameter/nebula_strength = 0.8
shader_parameter/show_planet = false
shader_parameter/warp = 0.0

[sub_resource type="Resource" id="Resource_moon"]
script = ExtResource("4_data")
title = "Луна"
description = "Облёт кратеров и прогулка в лёгкой гравитации — для первого полёта."
accent_color = Color(0.7, 0.82, 1, 1)
planet_color_a = Color(0.26, 0.26, 0.28, 1)
planet_color_b = Color(0.8, 0.8, 0.78, 1)
atmosphere_color = Color(0.32, 0.36, 0.45, 1)

[sub_resource type="Resource" id="Resource_mars"]
script = ExtResource("4_data")
title = "Марс"
scene = "res://scenes/design/designer.tscn"
description = "Пыльные бури, каньон Маринер и сувениры с вершины Олимпа."
has_missions = true
accent_color = Color(1, 0.5, 0.3, 1)
planet_color_a = Color(0.42, 0.13, 0.06, 1)
planet_color_b = Color(0.88, 0.45, 0.22, 1)
atmosphere_color = Color(1, 0.5, 0.3, 1)

[sub_resource type="Resource" id="Resource_saturn"]
script = ExtResource("4_data")
title = "Сатурн"
description = "Самый дальний маршрут: полёт вдоль колец и вид на полярный шторм."
accent_color = Color(1, 0.8, 0.4, 1)
planet_color_a = Color(0.62, 0.48, 0.28, 1)
planet_color_b = Color(0.96, 0.86, 0.62, 1)
atmosphere_color = Color(1, 0.85, 0.55, 1)
gas_giant = true
rings = true

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_notice"]
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0
bg_color = Color(0.03, 0.05, 0.12, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.75, 0.35, 0.7)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_select")
levels = Array[ExtResource("4_data")]([SubResource("Resource_moon"), SubResource("Resource_mars"), SubResource("Resource_saturn")])

[node name="Background" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_bg")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
text = "НОВАЯ КОМНАТА"

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_override_font_sizes/font_size = 18
text = "НАЗАД"

[node name="Subtitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "ВЫБЕРИ, КУДА ПОЛЕТИТ ЭКИПАЖ"

[node name="Cards" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 28
alignment = 1

[node name="Hint" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Стрелки — выбрать  ·  Enter — создать комнату  ·  Esc — назад"
horizontal_alignment = 1

[node name="Notice" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -64.0
offset_right = 260.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(1, 0.85, 0.6, 1)
theme_override_font_sizes/font_size = 17
theme_override_styles/normal = SubResource("StyleBoxFlat_notice")
horizontal_alignment = 1
vertical_alignment = 1

[node name="Fade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)
